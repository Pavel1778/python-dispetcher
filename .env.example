# Copy to .env and fill in real values. Never commit the filled .env.
#
# Supabase PostgreSQL connection string. Use the *pooler* or direct connection
# string from Supabase project settings. This credential is server-side only.
# It must never reach the browser or a Jr agent's instructions.
SUPABASE_DB_URL=

# OpenHands Cloud API key. Create it in the Cloud UI under Settings > API Keys.
# Server-side only.
OPENHANDS_API_KEY=

# Cloud base URL. Override only for a self-hosted Enterprise instance.
OPENHANDS_CLOUD_URL=https://app.all-hands.dev

# Optional: dispatcher identity and timing.
DISPATCHER_WORKER_ID=dispatcher-1
DISPATCHER_LEASE_SECONDS=300
