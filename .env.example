# Copy to .env and fill in real values. NEVER commit .env.
# Values below are placeholders only - they are not real credentials.

# --- OpenHands Cloud ---
# Preferred variable name:
OPENHANDS_CLOUD_API_KEY=sk-REPLACE_ME
# Fallback used only if OPENHANDS_CLOUD_API_KEY is unset:
OPENHANDS_API_KEY=
OPENHANDS_API_BASE=https://app.all-hands.dev
OPENHANDS_HTTP_TIMEOUT_SECONDS=30
OPENHANDS_HTTP_MAX_RETRIES=3

# --- Persistence (PostgreSQL / Supabase connection string) ---
# Leave empty to run with the in-memory store (NOT durable).
# For the Supabase "Transaction pooler", use the pooler host/port and a
# URL-encoded password. Example shape (port 6543 = transaction pooler):
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Fallback used only if DATABASE_URL is unset:
SUPABASE_DB_URL=
# Transaction pooler (PgBouncer) disables prepared statements. Keep true when
# using port 6543; set false for a direct/session connection (port 5432).
DATABASE_TRANSACTION_POOLER=true
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# --- Dispatcher loop ---
SERVICE_NAME=openhands-dispatcher
DISPATCHER_ENABLE_BACKGROUND_LOOP=true
DISPATCHER_POLL_INTERVAL_SECONDS=15
DISPATCHER_BATCH_SIZE=5
DISPATCHER_MAX_ATTEMPTS=5
DISPATCHER_LEASE_SECONDS=120
DISPATCHER_START_TASK_TIMEOUT_SECONDS=900

# --- Jr bridge (Sr -> Jr child conversation creation) ---
JR_BRIDGE_ENABLED=true
JR_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# --- Monitoring (Better Stack heartbeat) ---
HEARTBEAT_URL=

LOG_LEVEL=INFO
DEFAULT_REPOSITORY=
DEFAULT_BRANCH=
