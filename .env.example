# Copy to .env and fill in real values. Never commit the filled .env.
#
# Supabase PostgreSQL connection string. Use the *pooler* or direct connection
# string from Supabase project settings. This credential is server-side only.
# It must never reach the browser or a Jr agent's instructions.
SUPABASE_DB_URL=

# Server-side prepared statements are off by default, which is the safe choice
# behind any transaction-mode pooler (Supabase PgBouncer on port 6543, and any
# other pooler that reuses a server session). Preparation is safe only on a
# direct session-mode connection; set PSYCOPG_PREPARE=session to opt in there.
PSYCOPG_PREPARE=

# Apply the idempotent SQL migrations on start, recording each file's checksum
# in schema_migrations. Required on Render's free plan, which has no shell for
# psql. Set false to apply them out of band.
AUTO_MIGRATE=true

# OpenHands Cloud API key. Create it in the Cloud UI under Settings > API Keys.
# Server-side only.
OPENHANDS_API_KEY=

# Cloud base URL. Override only for a self-hosted Enterprise instance.
OPENHANDS_CLOUD_URL=https://app.all-hands.dev

# SSRF policy. Every operator-supplied base URL (OPENHANDS_CLOUD_URL, the
# sandbox agent-server URL, GITHUB_API_URL, <PROVIDER>_BASE_URL) is checked
# against this policy: a non-http(s) scheme, embedded credentials, a loopback,
# private-network, link-local or cloud-metadata target is refused. Set this to
# 1 only to talk to a service on a private network (a local sandbox or a test
# fixture); leave it unset on a public deployment, so a URL aimed at the host's
# own network or at a metadata endpoint is refused. A metadata address is
# refused even when this is 1.
# NEXUS_ALLOW_PRIVATE_TARGETS=0

# Bearer token that guards the machine API. Required to bind 0.0.0.0. Distinct
# from the login below; a script sends it instead of a session cookie. Generate
# a long random value. Server-side only.
WEB_AUTH_TOKEN=

# Owner login (the human path). Generate the hash with:
#   python -m orchestration.web_auth hash
# and the session secret with:
#   python -m orchestration.web_auth secret
# Never put the raw password here, and never reuse the API key as the secret.
AUTH_USERNAME=owner
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Optional: how long a login lasts, in seconds. A session is extended by being
# used: it ends AUTH_SESSION_TTL_SECONDS after the last request (default 30
# days) and, however much it is used, AUTH_SESSION_MAX_SECONDS after the login
# (default 90 days). Allowed: 300 .. 34560000. Changing AUTH_SESSION_SECRET
# ends every open session.
# AUTH_SESSION_TTL_SECONDS=2592000
# AUTH_SESSION_MAX_SECONDS=7776000

# Optional: force the Secure cookie flag. Default: on when the request arrives
# with X-Forwarded-Proto: https (i.e. behind Render's TLS proxy).
# WEB_COOKIE_SECURE=true

# Optional: select an OpenHands Cloud agent profile by id, so conversations use
# that profile's tools, MCP servers and skills. Leave empty to inherit the
# account's own active profile (recommended; never overwrites account settings).
OPENHANDS_AGENT_PROFILE_ID=

# Optional: how the direct transport handles a repository-scoped task. A sandbox
# conversation starts in an empty LocalWorkspace with no selected_repository
# field, so:
#   prompt  (default) prepend a deterministic "clone owner/name at branch" step
#   refuse  raise, so a repository task dead-letters with a clear reason
#   allow   ignore the field (only for repository-less work)
# OPENHANDS_DIRECT_REPO_MODE=prompt

# Optional: how many trusted proxies sit in front of this app. The client IP is
# read from the rightmost trusted hop of X-Forwarded-For, because the leftmost
# value is client-supplied and must never key a rate limit. Default 1 (a single
# platform load balancer). Set 0 for a direct connection with no proxy, and raise
# it for each extra proxy of your own.
# TRUSTED_PROXY_HOPS=1

# Optional: in-memory login ceilings per minute. Per IP (default 30) and
# endpoint-wide (default 120). The global one cannot be moved by any header.
# LOGIN_MAX_ATTEMPTS_PER_IP=30
# LOGIN_MAX_ATTEMPTS_GLOBAL=120

# GitHub discovery uses this server-side token; never enter it in the UI.
# Write operations also require GITHUB_ENABLE_WRITES=true, an active owner
# session, CSRF, and a separate confirmation. Grant minimum GitHub permissions.
GITHUB_TOKEN=
GITHUB_ENABLE_WRITES=false

# Optional: largest upload accepted by the file laboratory and voice notes,
# in bytes. Default 33554432 (32 MiB). Uploaded bytes are stored in PostgreSQL,
# never on the server's filesystem.
# NEXUS_MAX_UPLOAD_BYTES=33554432

# ---------------------------------------------------------------------------
# LLM orchestrator cascade (Gemini -> Groq -> OpenRouter -> OpenHands). Only
# configured providers are used; a missing key just skips that provider. These
# keys are server-side only and are never sent to a model or written to a log.
# The cascade only *proposes* plans; OpenHands remains the executor.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides (base URL / model per provider).
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENHANDS_ORCHESTRATOR_MODEL=gpt-5

# ---------------------------------------------------------------------------
# Evidence Trust Engine (Ed25519). Generate a lab key pair with:
#   python -m orchestration.evidence_keygen --key-id nexus-lab
# The private key signs evidence; the keyring lets the server verify signatures.
# A record signed by a key not in the keyring is UNVERIFIED, never VERIFIED.
# Both are server-side only; never commit real values.
NEXUS_EVIDENCE_KEY_ID=nexus-lab
NEXUS_EVIDENCE_PRIVATE_KEY=
# Comma-separated key_id:base64public entries. Append ':revoked' to a key to
# make records it signed verify as UNVERIFIED without deleting history.
NEXUS_EVIDENCE_KEYRING=

# ---------------------------------------------------------------------------
# MCP server (stdio). Point it at the same database; the principal decides which
# projects the tools can reach. No arbitrary shell/SQL/eval tool is exposed.
# NEXUS_DB_URL falls back to SUPABASE_DB_URL.
NEXUS_DB_URL=
NEXUS_MCP_PRINCIPAL=machine:default

# ---------------------------------------------------------------------------
# CLI (thin client over the HTTP API). NEXUS_URL is the base URL; NEXUS_TOKEN is
# a bearer token (falls back to WEB_AUTH_TOKEN). The token is never printed.
NEXUS_URL=
NEXUS_TOKEN=

# ---------------------------------------------------------------------------
# Autonomous lab. The web server advances runs itself (see NEXUS_LAB_INLINE
# below). A separate worker can do it instead, or as well:
#   python -m orchestration.lab_worker --worker-id lab-1
# NEXUS_SECRET_KEY encrypts stored GitHub PATs and OpenHands API keys (Fernet).
# REQUIRED to add a GitHub or OpenHands account; without it the account endpoint
# refuses rather than store a plaintext credential. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_SECRET_KEY=

# The web server runs the lab loop on a thread of its own unless this is 0
# (or false / no / off). It is on by default because a deployment that is one
# web process otherwise accepts runs and never starts them. Set it to 0 where
# `python -m orchestration.lab_worker` runs as its own process and should be
# the only one advancing runs; left on, both do, and the leases keep them
# apart. Either way the loop registers a heartbeat (kind "inline" or "worker").
# NEXUS_LAB_INLINE=0

# How long one task's conversation may run before the task is given up (seconds).
# NEXUS_TASK_TIMEOUT_SECONDS=7200

# ---------------------------------------------------------------------------
# Durable runs. A run started from the chat (or over REST without explicit
# budgets) does not give a task up. A task gets its attempts (three) inside one
# work cycle; when they are used up it waits and then starts the next cycle
# with the attempts restored. The wait before cycle N is
# NEXUS_RETRY_BASE_SECONDS * 2**(N-1), capped at NEXUS_RETRY_MAX_SECONDS: a
# minute, two, four ... up to an hour. A start the service refuses (HTTP 429)
# is not an attempt: the task waits as long as Retry-After asks.
# NEXUS_RETRY_BASE_SECONDS=60
# NEXUS_RETRY_MAX_SECONDS=3600
# The operator's ceiling on work cycles per task. 0 (the default) is no
# ceiling. When it is reached the task stops and its run waits for a person
# ("blocked"); nothing is deleted.
# NEXUS_RETRY_MAX_CYCLES=0
# A conversation that shows no sign of life for this long is taken for hung:
# it is told to stop and the task is started again. 0 switches the check off.
# NEXUS_TASK_STALL_SECONDS=1800
# How many tasks may be at work at once, over all runs (0 = no limit). A task
# over the limit is not refused; it is taken when another one ends.
# NEXUS_LAB_MAX_ACTIVE_TASKS=8

# ---------------------------------------------------------------------------
# Where an OpenHands connection added through the API may point. It obeys the
# SSRF policy above (NEXUS_ALLOW_PRIVATE_TARGETS) and is checked further: the
# host is looked up and every address it has must be public, when the connection
# is saved and again when a socket is opened (so a DNS answer that changes later
# does not get through). A self-hosted OpenHands on a private network is allowed
# by naming its host here - narrower than NEXUS_ALLOW_PRIVATE_TARGETS=1, which
# permits every private address:
# NEXUS_OPENHANDS_ALLOWED_HOSTS=openhands.internal,10.0.0.5:3000
# A host named here is permitted wherever the SSRF policy is applied (the
# connection's URL and the sandbox URLs the service hands out). A cloud metadata
# address is refused even for a host named here.

# ---------------------------------------------------------------------------
# OpenHands account pool. Any number of accounts can be stored through the API
# (/api/openhands/accounts); each is verified against Cloud before it is
# trusted and its key is encrypted with NEXUS_SECRET_KEY. The selection mode is
# manual | auto | failover | load_balancing and is set through the API
# (/api/openhands/pool). A project may be given its own list of connections
# (a primary and backups, /api/v1/projects/<id>/executors); it then uses only
# those. See docs/DURABLE-RUNS.md.
#
# No account needs to be configured to run: with none stored, every task runs
# under the process-wide OPENHANDS_API_KEY (the pre-existing behaviour).
#
# Each account has an enable/disable switch, a priority (the failover order), a
# health, a masked key hint, and optional limits: max_concurrent_tasks (the
# concurrency ceiling; automatic selection skips a full account) and
# daily_conversation_limit (the account's daily ceiling, informational). Edit
# the non-secret fields with POST /api/openhands/accounts/{id}/edit and probe
# endpoint reachability with POST /api/openhands/accounts/{id}/connection.

