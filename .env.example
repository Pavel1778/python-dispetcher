# Copy to .env and fill in real values. Never commit the filled .env.
#
# Supabase PostgreSQL connection string. Use the *pooler* or direct connection
# string from Supabase project settings. This credential is server-side only.
# It must never reach the browser or a Jr agent's instructions.
SUPABASE_DB_URL=

# Server-side prepared statements are off by default, which is the safe choice
# behind any transaction-mode pooler (Supabase PgBouncer on port 6543, and any
# other pooler that reuses a server session). Preparation is safe only on a
# direct session-mode connection; set PSYCOPG_PREPARE=session to opt in there.
PSYCOPG_PREPARE=

# Apply the idempotent SQL migrations on start, recording each file's checksum
# in schema_migrations. Required on Render's free plan, which has no shell for
# psql. Set false to apply them out of band.
AUTO_MIGRATE=true

# OpenHands Cloud API key. Create it in the Cloud UI under Settings > API Keys.
# Server-side only.
OPENHANDS_API_KEY=

# Cloud base URL. Override only for a self-hosted Enterprise instance.
OPENHANDS_CLOUD_URL=https://app.all-hands.dev

# Bearer token that guards the machine API. Required to bind 0.0.0.0. Distinct
# from the login below; a script sends it instead of a session cookie. Generate
# a long random value. Server-side only.
WEB_AUTH_TOKEN=

# Owner login (the human path). Generate the hash with:
#   python -m orchestration.web_auth hash
# and the session secret with:
#   python -m orchestration.web_auth secret
# Never put the raw password here, and never reuse the API key as the secret.
AUTH_USERNAME=owner
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Optional: force the Secure cookie flag. Default: on when the request arrives
# with X-Forwarded-Proto: https (i.e. behind Render's TLS proxy).
# WEB_COOKIE_SECURE=true

# Optional: select an OpenHands Cloud agent profile by id, so conversations use
# that profile's tools, MCP servers and skills. Leave empty to inherit the
# account's own active profile (recommended; never overwrites account settings).
OPENHANDS_AGENT_PROFILE_ID=

# Optional: how the direct transport handles a repository-scoped task. A sandbox
# conversation starts in an empty LocalWorkspace with no selected_repository
# field, so:
#   prompt  (default) prepend a deterministic "clone owner/name at branch" step
#   refuse  raise, so a repository task dead-letters with a clear reason
#   allow   ignore the field (only for repository-less work)
# OPENHANDS_DIRECT_REPO_MODE=prompt

# Optional: how many trusted proxies sit in front of this app. The client IP is
# read from the rightmost trusted hop of X-Forwarded-For, because the leftmost
# value is client-supplied and must never key a rate limit. Default 1 (a single
# platform load balancer). Set 0 for a direct connection with no proxy, and raise
# it for each extra proxy of your own.
# TRUSTED_PROXY_HOPS=1

# Optional: in-memory login ceilings per minute. Per IP (default 30) and
# endpoint-wide (default 120). The global one cannot be moved by any header.
# LOGIN_MAX_ATTEMPTS_PER_IP=30
# LOGIN_MAX_ATTEMPTS_GLOBAL=120

# GitHub discovery uses this server-side token; never enter it in the UI.
# Write operations also require GITHUB_ENABLE_WRITES=true, an active owner
# session, CSRF, and a separate confirmation. Grant minimum GitHub permissions.
GITHUB_TOKEN=
GITHUB_ENABLE_WRITES=false

# ---------------------------------------------------------------------------
# Evidence Trust Engine (Ed25519). Generate a lab key pair with:
#   python -m orchestration.evidence_keygen --key-id nexus-lab
# The private key signs evidence; the keyring lets the server verify signatures.
# A record signed by a key not in the keyring is UNVERIFIED, never VERIFIED.
# Both are server-side only; never commit real values.
NEXUS_EVIDENCE_KEY_ID=nexus-lab
NEXUS_EVIDENCE_PRIVATE_KEY=
# Comma-separated key_id:base64public entries. Append ':revoked' to a key to
# make records it signed verify as UNVERIFIED without deleting history.
NEXUS_EVIDENCE_KEYRING=

# ---------------------------------------------------------------------------
# MCP server (stdio). Point it at the same database; the principal decides which
# projects the tools can reach. No arbitrary shell/SQL/eval tool is exposed.
# NEXUS_DB_URL falls back to SUPABASE_DB_URL.
NEXUS_DB_URL=
NEXUS_MCP_PRINCIPAL=machine:default

# ---------------------------------------------------------------------------
# CLI (thin client over the HTTP API). NEXUS_URL is the base URL; NEXUS_TOKEN is
# a bearer token (falls back to WEB_AUTH_TOKEN). The token is never printed.
NEXUS_URL=
NEXUS_TOKEN=

